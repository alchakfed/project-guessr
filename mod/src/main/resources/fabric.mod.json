  "authors": [
    "You"
  ],
  "contact": {
    "sources": "https://example.com/projectguessr"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/projectguessr/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.projectguessr.ProjectGuessrClient"
    ]
  },
  "mixins": [
    "projectguessr.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "journeymap": "*"
  }
